# Copy to .env and replace the two local secrets before starting the API.
DATABASE_URL=postgres://sweety:sweety_local_only@localhost:5432/sweety
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3001
NODE_ENV=development
DEMO_EMAIL=demo@sweety.local
DEMO_PASSWORD=choose-a-local-demo-password
# Optional direct PostgreSQL connection for hosted migration/seed commands.
MIGRATION_DATABASE_URL=
# Public demo notice only; never put account secrets in VITE_ variables.
VITE_DEMO_MODE=false
